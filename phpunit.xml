<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            The suite does not fit in PHP's default 128M.

            It is not a leak: 745 tests in one process, each booting the
            application and rendering real Blade views, and PHPUnit holds the
            result of every one of them until the run ends. It crossed the
            default limit somewhere around the six-hundredth test, and the
            symptom was ugly — a fatal in whichever unrelated test happened to
            be running when the ceiling was hit, complete with a hundred-frame
            stack trace, which reads exactly like a broken test rather than
            like a full process.

            Set here rather than in anyone's php.ini so a fresh clone runs the
            suite on the first try.
        -->
        <ini name="memory_limit" value="512M"/>

        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>

        <!--
            Tests run against a real MySQL 8 database, NOT sqlite :memory:.

            The appointment double-booking guarantee is enforced by a UNIQUE
            index on appointments.slot_key, relying on MySQL's rule that a
            unique index permits unlimited NULLs (so a cancelled appointment
            releases its slot). SQLite's type affinity, its differing FK
            enforcement, and its divergent behaviour around JSON columns and
            decimal precision mean a green sqlite suite would not prove that
            the constraint actually holds in production. Only the credentials
            are inherited from .env — the database name is pinned here so a
            test run can never touch the development database.
        -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="rehlet_sehha_test"/>
        <env name="DB_URL" value=""/>

        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
