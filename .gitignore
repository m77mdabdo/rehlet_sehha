.phpunit.result.cache
/.fleet
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules
# Photography ORIGINALS. Licensed stock, ~48 MB, and we are not the only
# holder of them — they do not belong in this repository's history, and a
# deploy must never depend on them being present.
#
# `php artisan clinic:process-photos` turns them into the small WebP set under
# public/media, and THAT is committed: it is what the site serves, it is two
# orders of magnitude smaller, and it is reproducible from the manifest in
# config/photos.php. See docs/media/photography.md for where the originals are.
/public/photos

# THE VITE BUILD IS COMMITTED, DELIBERATELY. Do not re-add /public/build here.
#
# Laravel ignores this by default, on the assumption that the build runs during
# deployment. It cannot here: there is no Node on the Hostinger plan, which is
# why the runbook says not to run `composer setup`. The compiled CSS and JS are
# the only copy that will ever exist on the server, so they have to travel with
# the repository.
#
# This was ignored until 2026-10-12 and the build was force-added once, in
# 68fb233, which worked exactly once. The next build produced new hashed
# filenames, `git add -A` skipped them in silence because they matched this
# rule, and the commit deleted the old tracked files while adding nothing in
# their place. Production served a homepage with no stylesheet and no script
# until it was spotted — the second time in this project that a generated,
# gitignored file took the site down after a deploy, after the Filament assets
# did the same thing.
#
# /public/hot is still ignored: that is the dev-server marker and must never
# reach production.
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
Homestead.json
Homestead.yaml
Thumbs.db

# Filament's published assets — 4.2 MB of JS, CSS and fonts copied out of
# vendor/. Not committed, because they are a BUILD ARTEFACT of the installed
# package version, not source: keeping them in git means every Filament upgrade
# shows as thousands of lines of minified diff, and a stale copy silently
# disagreeing with the vendor code it came from.
#
# composer.json already runs `php artisan filament:upgrade` on
# post-autoload-dump, which republishes them, so `composer install` on the
# server regenerates all three directories. If the panel ever loads unstyled
# after a deploy, that command is what did not run.
/public/css/filament
/public/js/filament
/public/fonts/filament

# Staged video candidates from clinic:fetch-pexels-videos. Same rule as the
# photo inbox: nothing here is accepted, and the ones that are get copied into
# public/brand/ and recorded in config/hero.php.
/public/video/inbox
