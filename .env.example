APP_NAME="Rehlet Sehha"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Debugbar is a dev dependency and never loads outside local anyway, but its
# on-screen widget sits over the bottom-left of every page and gets in the way
# of reviewing a design. OPT-IN LOCALLY: set this to true when you actually
# want the profiler, and leave it false the rest of the time. Leaving the key
# out entirely turns the widget ON, which is why it is written here rather than
# just omitted.
DEBUGBAR_ENABLED=false
# Production domain. Local development overrides this in .env with
# http://localhost:8000 (or whatever the local server is bound to) —
# APP_URL is what generates absolute URLs in mails, canonical tags and
# hreflang, so the deployed value has to be the real, final domain.
APP_URL=https://rehletsehha.com
# Application timezone is hardcoded to UTC in config/app.php (see comment there).
# This is the clinic's wall-clock timezone, used for display and slot generation only.
CLINIC_TIMEZONE=Africa/Cairo

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_EG

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=rehlet_sehha
DB_USERNAME=rehlet_sehha
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Cache store. `file`, not `database`.
#
# Measured on the homepage with its five content sets cached:
#   no cache          11.6 ms/request
#   database cache    10.1 ms/request   (13% — it trades six content queries
#                                        for six queries against `cache`)
#   file cache         8.1 ms/request   (30%)
#
# Hostinger shared hosting is a single server, so there is no cache-coherence
# problem to solve and no reason to pay a database round trip to avoid one.
#
# REVISIT THIS IF WE EVER RUN MORE THAN ONE APPLICATION SERVER: a file cache is
# per-machine, so each node would keep its own copy and a price edited on one
# would stay stale on the others until its TTL expired. Redis is the answer at
# that point, not database — and it would also let PublicContent use cache tags
# instead of an explicit key list.
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Seeded staff accounts. Leave the passwords BLANK in production: the seeder
# then generates a strong random one and prints it once to the console.
# Never commit a real password here.
ADMIN_EMAIL=admin@rehletsehha.test
ADMIN_PASSWORD=
DOCTOR_EMAIL=doctor@rehletsehha.test
DOCTOR_PASSWORD=

# Days of notification delivery logs to keep before model:prune deletes them.
CLINIC_NOTIFICATION_LOG_RETENTION_DAYS=90

# Days of audit trail to keep. Longer than the delivery log: an audit trail
# answers who changed a patient record and when, months after the fact.
CLINIC_ACTIVITY_LOG_RETENTION_DAYS=365

# Where the clinic receives human enquiries. Read by config/clinic.php and
# rendered in the footer and contact block.
CLINIC_CONTACT_EMAIL=info@rehletsehha.com

# Mail transport. Hostinger SMTP.
#
# Note the split, and keep it: no-reply@ SENDS automated confirmations and
# reminders; info@ RECEIVES enquiries from people. Sending automated mail from
# info@ would land every "sorry, can I move my appointment?" reply in the same
# inbox as everything else, where it competes with newsletters and supplier
# mail for the attention of whoever is on reception that day. Reply-To on every
# patient mail points at info@ regardless, so a patient who hits Reply reaches
# a person; see App\Mail\AppointmentMailable.
#
# MAIL_MAILER stays `log` in this example file. Committing `smtp` here means
# any developer who copies .env.example and happens to have the password in
# their environment starts mailing real patients from their laptop.
MAIL_MAILER=log

# Port 465 is implicit TLS ("SMTPS"): encrypted from the first byte, rather than
# starting in the clear and upgrading via STARTTLS on 587.
#
# MAIL_SCHEME, not MAIL_ENCRYPTION: config/mail.php has no `encryption` key in
# Laravel 12, so that variable would look like configuration and do nothing.
# Stated explicitly rather than left for MailManager to infer from port 465,
# because an inferred security property is one nobody can grep for.
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@rehletsehha.com

# Never committed. Paste the mailbox password into .env on the server only.
MAIL_PASSWORD=

MAIL_FROM_ADDRESS=no-reply@rehletsehha.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
