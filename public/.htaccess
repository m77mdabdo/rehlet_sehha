<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# ------------------------------------------------------------------------------
# MIME TYPES APACHE MAY NOT KNOW
# ------------------------------------------------------------------------------
#
# MEASURED, NOT ASSUMED. On Apache 2.4.56 these three files come back with NO
# Content-Type header at all:
#
#   .webp    every photograph on the site
#   .woff2   all eight font files
#   .mp4     the hero video, which is the first thing on the homepage
#
# Browsers mostly sniff their way through it, but three things break quietly.
# Video is the one that matters: a player that cannot determine the type may
# refuse the file outright, and Safari is particular about seeing video/mp4 on
# a range request. The other two are subtler — every rule below that selects by
# TYPE silently does not apply to a response that has no type, so the caching
# and compression policy would have skipped exactly the files it was written
# for.
#
# Three lines, harmless on a host that already knows these types, and they make
# the rest of this file behave the same way everywhere.
AddType image/webp .webp
AddType font/woff2 .woff2
AddType video/mp4 .mp4

# ------------------------------------------------------------------------------
# COMPRESSION
# ------------------------------------------------------------------------------
#
# THE SINGLE LARGEST PERFORMANCE LEVER ON THIS SITE, and it was missing.
#
# Measured on the booking page: Livewire's runtime is 251 KB of JavaScript in
# production, on top of 59 KB of CSS and up to 177 KB of HTML on the homepage.
# Uncompressed that is close to half a megabyte for somebody on a phone in
# Egypt, and none of it was being compressed because nothing here asked for it.
# Text compresses roughly 4:1, so this is the difference between ~460 KB and
# ~140 KB on the page a patient has to reach to book anything.
#
# Brotli first where the module exists — it beats gzip by another 15-20% on
# JavaScript — with mod_deflate as the fallback that is present everywhere.
# Both blocks are guarded, so a host with neither module still serves the site.
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css
    AddOutputFilterByType BROTLI_COMPRESS application/javascript application/x-javascript
    AddOutputFilterByType BROTLI_COMPRESS application/json application/ld+json
    AddOutputFilterByType BROTLI_COMPRESS application/xml image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/ld+json
    AddOutputFilterByType DEFLATE application/xml image/svg+xml

    # NOT images, video, or fonts. WebP, MP4 and WOFF2 are already compressed;
    # running them through deflate spends CPU to make them very slightly
    # larger. woff2 in particular is Brotli-compressed internally already.
</IfModule>

# ------------------------------------------------------------------------------
# CACHING
# ------------------------------------------------------------------------------
#
# The built assets carry a content hash in the filename (app-BLlCntPy.css), so
# a change produces a new URL and a long max-age can never serve a stale file.
# A year is the standard for that pattern and is safe precisely because the
# name changes.
#
# The photography and the brand files do NOT carry a hash, so they get a month
# — long enough to matter for a returning visitor, short enough that replacing
# a photograph is visible within a reasonable window rather than never.
#
# HTML is deliberately absent from this block. Every page is a live document
# with appointment availability and article content in it, and the application
# sets its own Cache-Control per response.
<IfModule mod_expires.c>
    ExpiresActive On

    <If "%{REQUEST_URI} =~ m#^/build/#">
        ExpiresDefault "access plus 1 year"
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>

    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType video/mp4 "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
